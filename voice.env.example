# Config for the ringback-voice MCP. setup.sh copies this to `voice.env` (gitignored);
# the launcher sources it automatically (run_voice_mcp.sh on macOS, run_voice_mcp.py on
# Linux/Windows). Only the 3 REQUIRED vars below need filling in — the rest have defaults.

# ===== REQUIRED — your SIP account =====
# Free account: https://subscribe.linphone.org  (or "Create account" in the Linphone app).
# Your address is sip:<username>@sip.linphone.org
export VOICE_SIP_ID="sip:YOURUSER@sip.linphone.org"
export VOICE_SIP_USER="YOURUSER"
export VOICE_SIP_PASS="YOUR_SIP_PASSWORD"

# ===== OPTIONAL — sensible defaults, change only if needed =====
# Who to call (defaults to VOICE_SIP_ID — i.e. it calls your own phone):
# export VOICE_SIP_CALLEE="sip:YOURUSER@sip.linphone.org"
# SIP registrar/proxy (default works for sip.linphone.org):
# export VOICE_SIP_PROXY="sip:sip.linphone.org;transport=tls"
# Caller-ID name shown on your phone when the agent calls (default: bare SIP user):
# export VOICE_DISPLAY_NAME="My Claude"
# STUN server — advertise our PUBLIC address so two-way audio works behind NAT (REQUIRED when
# running in Docker; not needed for a native/host-network setup). Blank = off:
# export VOICE_STUN="stun.l.google.com:19302"   # or stun.linphone.org
# Speech-to-text model — base.en=fast/rough, small.en=balanced(default), medium.en=accurate/slow:
# export WHISPER_MODEL="$HOME/.whisper-models/ggml-small.en.bin"

# ===== OPTIONAL — text-to-speech (cross-platform) =====
# Engine: auto (default; Piper if installed, else the OS voice) | piper | say | espeak | sapi
# export VOICE_TTS="auto"
# Piper voice model (cross-platform default voice; needs the matching .onnx.json beside it):
# export VOICE_PIPER_MODEL="$HOME/.piper-voices/en_US-lessac-medium.onnx"
# Custom TTS — any command that writes a WAV; {text} and {out} are substituted:
# export VOICE_TTS_CMD="mytts --text {text} --out {out}"
# Force pjsua2 null audio device (auto=on except macOS; required headless): 1 | 0 | auto
# export VOICE_NULL_AUDIO="auto"
# Watchdog presence override (Wayland/headless where idle can't be read): present | absent
# export RINGBACK_PRESENCE="absent"

# ===== OPTIONAL — silence diagnostics =====
# Every listen turn already logs ONE summary line to stderr (lands in the MCP client's
# logs): exit reason, max RMS vs threshold, voiced polls, recorded bytes. These add more:
# Chatty detail — log each transcript the hallucination filter discards:
# export VOICE_DEBUG=1
# Keep the recorded audio of any SILENT turn for replay (default dir: /tmp/ringback-debug):
# export VOICE_DEBUG_KEEP_WAV=1
# export VOICE_DEBUG_WAV_DIR="/tmp/ringback-debug"

# ===== OPTIONAL — toolchain paths (only if launcher auto-detection fails) =====
# export PJPROJECT_DIR="$HOME/build/pjproject-2.17"
# export PYTHON_BIN="$(command -v python3)"
# export OPENSSL_PREFIX="$(brew --prefix openssl@3)"

# Cloud STT ("ears"): any OpenAI-compatible /audio/transcriptions endpoint, Groq by default.
# One transcription per turn after you stop talking; falls back to local whisper on failure.
# export VOICE_STT_KEY="..."            # or VOICE_STT_ENV_FILE=/path/to/file holding VOICE_STT_KEY=...
# export VOICE_STT_URL="https://api.groq.com/openai/v1/audio/transcriptions"
# export VOICE_STT_MODEL="whisper-large-v3-turbo"
# export VOICE_STT_LANG="zh"
# (older names GROQ_API_KEY / VOICE_GROQ_URL / VOICE_GROQ_MODEL / VOICE_GROQ_ENV_FILE still work)

# Privacy: pjsua logs (stderr and VOICE_LOG_FILE) are scrubbed of IPs, SIP routing/auth
# headers, SDP addresses/ICE candidates and SRTP keys by privacy.py before they are written.
# This reduces the risk of network info reaching a model's context; it is NOT isolation
# from an admin on the same host (a container on the same host is not isolation either).
# VOICE_LOG_RAW=1 writes unscrubbed logs — local debugging only, never feed them to a model.
# export VOICE_LOG_RAW=1

# ======================================================================================
# v0.2.0 additions. Everything below is optional and OFF unless noted. Names + example values only.
# The incoming-call and remote-MCP variables go in ~/.config/ringringring/inbound.env
# (plain KEY=VALUE lines, mode 600) or in the environment; the rest can live in voice.env.
# ======================================================================================

# ----- Incoming calls (plugin-inbound): a SECOND SIP account that receives the user's calls -----
# The user dials this account from Linphone; VOICE_SIP_ID above is then only used to recognize them.
# export VOICE_INBOUND_SIP_ID="sip:AGENTUSER@sip.linphone.org"
# export VOICE_INBOUND_SIP_USER="AGENTUSER"
# export VOICE_INBOUND_SIP_PASS="..."
# export VOICE_INBOUND_RING_TIMEOUT="45"     # seconds to keep ringing before giving up
# export VOICE_INBOUND_RTP_PORT="4100"       # RTP port of the incoming-call process (outgoing uses 4000)
# Trusted devices: ~/.config/ringringring/trusted_devices (one hashed device id per line).
# An EMPTY list does not block anything (the SIP address alone can be spoofed): fill it in.

# ----- Quiet listening (records the call in the background; OFF by default) -----
# export VOICE_QUIET_LISTEN="1"              # enables quiet_listen / wait_for_voice
# export VOICE_QUIET_CHUNK_SEC="10"          # transcription chunk length
# export VOICE_QUIET_MAX_SEC="600"           # keep at most the last N seconds
# export VOICE_QUIET_VOICED_SEC="0.3"        # loud time a chunk needs to count as voiced
# export VOICE_QUIET_RMS=""                  # loudness gate for quiet listening (blank = same as VOICE_LISTEN_RMS)
# export VOICE_WAIT_TICK="0.3"               # wait_for_voice poll interval (s)
# export VOICE_WAIT_VOICED_SEC="0.15"        # loud time that ends a wait_for_voice
# Push-on-voice (needs VOICE_QUIET_LISTEN=1; OFF by default): notify the agent when a sound starts
# export VOICE_PUSH_ON_VOICE="1"
# export VOICE_PUSH_TICK="3"                 # how often the sentry looks (s)
# export VOICE_PUSH_GAP_SEC="2"              # silence that ends one stretch of sound (s)
# export VOICE_PUSH_MIN_INTERVAL="15"        # minimum seconds between "still going" pushes

# ----- ElevenLabs Scribe speech-to-text (optional; no key = this layer is not used) -----
# export VOICE_STT_11LABS_KEY="..."          # or VOICE_STT_11LABS_ENV_FILE=/path/to/file holding VOICE_STT_11LABS_KEY=...
# export VOICE_STT_11LABS_MODEL="scribe_v2"
# export VOICE_STT_11LABS_LANG="zho"         # ISO-639-3 here (zho, eng, ...), unlike VOICE_STT_LANG
# export VOICE_STT_11LABS_URL="https://api.elevenlabs.io/v1/speech-to-text"
# export VOICE_STT_11LABS_TIMEOUT="8"
# Realtime streaming while the user talks (default off):
# export VOICE_STT_11LABS_STREAM="1"
# export VOICE_STT_11LABS_RT_URL="wss://api.elevenlabs.io/v1/speech-to-text/realtime"
# export VOICE_STT_11LABS_RT_MODEL="scribe_v2_realtime"
# export VOICE_STT_11LABS_RT_WAIT="3"
# Hearing mode: text (transcript only, default) | audio (raw audio attached) | both.
# Can be chosen per call with dial(hear=...). Use text unless your client can take audio input.
# export VOICE_STT_MODE="text"
# export VOICE_STT_AUDIO_MAX_SEC="60"        # cap on audio handed back per turn

# ----- HTTPS remote MCP with OAuth (run_remote.sh / remote_http.py), for Gemini / ChatGPT connectors -----
# export MCP_HOST="127.0.0.1"                # keep loopback and put a Cloudflare tunnel / HTTPS proxy in front
# export MCP_PORT="8895"
# export MCP_TRANSPORT="streamable-http"
# export MCP_OAUTH_ENABLED="1"               # REQUIRED if MCP_HOST is not loopback
# export MCP_OAUTH_ISSUER_URL="https://phone.example.com"
# export MCP_OAUTH_RESOURCE_URL="https://phone.example.com/mcp"    # blank = ISSUER_URL + /mcp
# export MCP_OAUTH_CONNECT_SECRET="..."      # the passphrase typed on the connection page; keep it secret
# export MCP_OAUTH_STORE="$HOME/.local/share/ringringring/oauth/oauth.json"
# export MCP_ALLOWED_HOSTS="phone.example.com"      # comma separated, DNS-rebinding protection
# export MCP_ALLOWED_ORIGINS="https://phone.example.com"
# export VOICE_REMOTE_ACCOUNT="inbound"      # which SIP account dials out: inbound | voice
# export VOICE_REMOTE_DISPLAY_NAME=""        # default caller-ID name for remote calls
# export VOICE_REMOTE_RTP_PORT="4200"

# ----- Sound events (EXPERIMENTAL, OFF by default): bring your own classifier endpoint -----
# The call engine POSTs each turn's WAV to your own classifier endpoint and adds the
# returned labels to the transcript as [heard: ...]. No classifier is included.
# export VOICE_SOUND_EVENTS="1"
# export VOICE_SOUND_URL="http://127.0.0.1:8765/"
# export VOICE_SOUND_KEY="..."               # shared secret, checked by your endpoint
